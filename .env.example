# Servidor
PORT=4000
NODE_ENV=development
SESSION_HOURS=12
COOKIE_SECURE=false

# Base de datos y archivos
# En Render Free usar /tmp/tallertech (Litestream restaura desde Supabase Storage).
DATA_DIR=./data
SEED_DEMO=true

# Primer usuario (solo se usa si la base está vacía)
ADMIN_USER=admin
ADMIN_PASSWORD=Admin1234!

# Secretos de producción. Generar valores aleatorios únicos.
# Si se cambian después de guardar datos, los datos de desbloqueo cifrados no podrán descifrarse.
# JWT_SECRET=reemplazar-por-un-secreto-largo-y-aleatorio
# ENCRYPTION_KEY=reemplazar-por-una-clave-hexadecimal-de-64-caracteres

# Litestream + Supabase Storage (solo producción / Render Free)
# Endpoint: https://<PROJECT_REF>.storage.supabase.co/storage/v1/s3
# LITESTREAM_REPLICA_URL=s3://tallertech-db/litestream?endpoint=https://<PROJECT_REF>.storage.supabase.co/storage/v1/s3
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=
